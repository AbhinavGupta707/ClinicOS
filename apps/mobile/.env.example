# Public configuration only. Never place credentials, tokens, patient identifiers, or secrets here.
# Release builds must use an approved HTTPS API origin. Loopback HTTP is accepted only in __DEV__.
EXPO_PUBLIC_CLINIC_OS_API_URL=

# Local fixture authentication is ignored unless __DEV__ is true and the explicit opt-in is true.
EXPO_PUBLIC_CLINIC_OS_ALLOW_DEV_SUBJECT=false
EXPO_PUBLIC_CLINIC_OS_DEV_SUBJECT=
