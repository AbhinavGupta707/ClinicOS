# ClinicOS local development environment.
# Copy to .env.local or app-specific env files. Do not commit real secrets.

NODE_ENV=development
CLINIC_OS_ENV=local

# Database / cache / workflow runtime
DATABASE_URL=postgresql://clinic_os_runtime:clinic_os_runtime@localhost:5432/clinic_os
WORKER_DATABASE_URL=postgresql://clinic_os_worker:clinic_os_worker@localhost:5432/clinic_os
MIGRATION_DATABASE_URL=postgresql://clinic_os_migrator:clinic_os_migrator@localhost:5432/clinic_os
CLINIC_OS_LOCAL_DB_ADMIN_URL=postgresql://clinic_os:clinic_os@localhost:5432/postgres
CLINIC_OS_API_USE_DEV_AUTH_FIXTURE=false
CLINIC_OS_API_USE_FIXTURE_REPOSITORY=false
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233

# Auth
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=clinic-os-local
KEYCLOAK_CLIENT_ID=clinic-os-web

# Object storage
S3_REGION=ap-south-1
S3_BUCKET=clinic-os-local

# Provider credentials should be supplied only in local env/secrets.
# `simulator` is valid only for local/dev contract tests. For staging,
# pilot-prod, and prod use an official provider or `unconfigured` to expose
# an honest unavailable state.
WHATSAPP_PROVIDER=simulator
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET_PROOF_REQUIRED=false
WHATSAPP_TEMPLATE_NAMESPACE=

PAYMENT_PROVIDER=simulator
PAYMENT_QR_MODE=payment_link_qr
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_URL=

TELEPHONY_PROVIDER=simulator
TELEPHONY_ACCOUNT_SID=
TELEPHONY_API_KEY=
TELEPHONY_API_TOKEN=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_REGION_SUBDOMAIN=api.in.exotel.com
TELEPHONY_VIRTUAL_NUMBER=
TELEPHONY_WEBHOOK_SECRET=

LLM_PROVIDER=simulator
LLM_BASE_URL=
LLM_MODEL_PRIMARY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=
TRANSCRIPTION_PROVIDER=simulator
TRANSCRIPTION_MODEL=
DEEPGRAM_API_KEY=
AI_DATA_RESIDENCY_NOTES=

# Cloud / DR posture. Local/dev may leave account/backend values blank; pilot-prod/prod
# must supply them from the ignored secret handoff or CI/OIDC runtime.
AWS_PROFILE=clinicos-human
AWS_REGION=ap-south-1
AWS_DR_REGION=ap-south-2
AWS_ACCOUNT_ID=
AWS_TERRAFORM_STATE_BUCKET=
AWS_TERRAFORM_LOCK_TABLE=
AWS_KMS_KEY_ALIAS=

# Alerting destination. `unconfigured` is acceptable for local/dev only.
ALERTING_PROVIDER=unconfigured
ALERTING_CONTACT_EMAIL=
ALERTING_SLACK_WEBHOOK_URL=
SENTRY_DSN=

# Backup/restore drills default to non-mutating dry-runs. Local execution requires
# an isolated restore-drill database, synthetic data, and explicit destructive opt-in.
BACKUP_RESTORE_DRILL_MODE=dry_run
BACKUP_RESTORE_TARGET_DATABASE_URL=postgresql://clinic_os:clinic_os@localhost:5432/clinic_os_restore_drill
BACKUP_RESTORE_ALLOW_DESTRUCTIVE=false
BACKUP_RESTORE_RPO_MINUTES=60
BACKUP_RESTORE_RTO_MINUTES=240

# Synthetic pilot inputs only; never point local/dev to real patient exports.
PILOT_SYNTHETIC_DATA_ONLY=true
PILOT_PATIENT_EXPORT_PATH=fixtures/synthetic/patients.csv
PILOT_APPOINTMENT_EXPORT_PATH=fixtures/synthetic/appointments.csv
PILOT_PRICEBOOK_PATH=fixtures/synthetic/pricebook.csv
PILOT_TEMPLATES_DIR=fixtures/synthetic/templates
PILOT_XRAY_SAMPLE_DIR=fixtures/synthetic/media
