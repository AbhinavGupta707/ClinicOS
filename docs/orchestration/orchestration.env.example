# Copy this file to `.secrets/orchestration.env` for autonomous checkpoint runs.
# Do not commit `.secrets/orchestration.env`.

# General
CLINIC_OS_AUTONOMOUS_MODE=true
CLINIC_OS_DEFAULT_BRANCH=main
CLINIC_OS_REMOTE_URL=https://github.com/AbhinavGupta707/ClinicOS.git

# GitHub
GITHUB_TOKEN=

# Browser/app verification
ENABLE_BROWSER_CHECKS=true
ENABLE_MOBILE_SIMULATOR_CHECKS=false
PLAYWRIGHT_BROWSERS_PATH=
DEFAULT_IOS_SIMULATOR_NAME=iPhone 17 Pro

# AWS / infrastructure
AWS_PROFILE=clinicos-human
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ACCOUNT_ID=
AWS_REGION=ap-south-1
AWS_DR_REGION=ap-south-2
AWS_TERRAFORM_STATE_BUCKET=
AWS_TERRAFORM_LOCK_TABLE=
AWS_KMS_KEY_ALIAS=

# WhatsApp / Meta or BSP sandbox
WHATSAPP_PROVIDER=simulator
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET_PROOF_REQUIRED=false
WHATSAPP_TEMPLATE_NAMESPACE=

# Razorpay sandbox
PAYMENT_PROVIDER=simulator
PAYMENT_QR_MODE=payment_link_qr
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_URL=

# Telephony sandbox
TELEPHONY_PROVIDER=simulator
TELEPHONY_ACCOUNT_SID=
TELEPHONY_API_KEY=
TELEPHONY_API_TOKEN=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_REGION_SUBDOMAIN=api.in.exotel.com
TELEPHONY_VIRTUAL_NUMBER=
TELEPHONY_WEBHOOK_SECRET=

# AI provider
LLM_PROVIDER=simulator
LLM_BASE_URL=
LLM_MODEL_PRIMARY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=
TRANSCRIPTION_PROVIDER=simulator
TRANSCRIPTION_MODEL=
DEEPGRAM_API_KEY=
AI_DATA_RESIDENCY_NOTES=

# Google Business Profile
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_BUSINESS_PROFILE_LOCATION_ID=

# ABDM sandbox
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=
ABDM_HIP_ID=
ABDM_HIU_ID=
ABDM_CM_ID=

# Pilot clinic input locations
PILOT_PATIENT_EXPORT_PATH=
PILOT_APPOINTMENT_EXPORT_PATH=
PILOT_PRICEBOOK_PATH=
PILOT_TEMPLATES_DIR=
PILOT_XRAY_SAMPLE_DIR=
PILOT_SYNTHETIC_DATA_ONLY=true
