{
  "realm": "${CLINIC_OS_REALM}",
  "enabled": true,
  "displayName": "ClinicOS",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "loginTimeout": 300,
  "loginActionTimeout": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 300,
  "accessCodeLifespanUserAction": 300,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 1800,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 3600,
  "clientOfflineSessionIdleTimeout": 1800,
  "clientOfflineSessionMaxLifespan": 3600,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "passwordPolicy": "length(14) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined) and passwordHistory(24) and forceExpiredPasswordChange(7776000)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "webAuthnPolicyRpEntityName": "ClinicOS",
  "webAuthnPolicySignatureAlgorithms": ["ES256", "RS256"],
  "webAuthnPolicyAttestationConveyancePreference": "not specified",
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "clinic-user",
        "description": "Authenticated ClinicOS workforce identity; product authorization remains in ClinicOS."
      },
      {
        "name": "platform-admin-authn",
        "description": "Authentication marker only; ClinicOS product role and MFA checks remain authoritative."
      }
    ]
  },
  "clientScopes": [
    {
      "name": "clinic-os-api-audience",
      "description": "Adds the ClinicOS API audience to interactive client access tokens.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "clinic-os-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "clinic-os-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "clinic-os-session-assurance",
      "description": "Exposes session and authentication assurance claims required by ClinicOS.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "authentication-methods",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "clinic-os-web-bff",
      "name": "ClinicOS Web BFF",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": ["${CLINIC_OS_WEB_CALLBACK_URI}"],
      "webOrigins": ["${CLINIC_OS_WEB_ORIGIN}"],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "clinic-os-api-audience",
        "clinic-os-session-assurance"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${CLINIC_OS_WEB_POST_LOGOUT_URI}",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true",
        "client.session.idle.timeout": "900",
        "client.session.max.lifespan": "28800"
      }
    },
    {
      "clientId": "clinic-os-mobile",
      "name": "ClinicOS Mobile",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": ["${CLINIC_OS_MOBILE_REDIRECT_URI}"],
      "webOrigins": [],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "clinic-os-api-audience",
        "clinic-os-session-assurance"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true",
        "client.session.idle.timeout": "1800",
        "client.session.max.lifespan": "28800"
      }
    },
    {
      "clientId": "clinic-os-api",
      "name": "ClinicOS API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    },
    {
      "alias": "webauthn-register",
      "name": "Webauthn Register",
      "providerId": "webauthn-register",
      "enabled": true,
      "defaultAction": false,
      "priority": 20
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    }
  ],
  "users": []
}
