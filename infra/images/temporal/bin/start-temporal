#!/bin/sh
set -eu

metadata_uri="${ECS_CONTAINER_METADATA_URI_V4:-}"
broadcast_address="${TEMPORAL_BROADCAST_ADDRESS:-}"

if [ -z "$broadcast_address" ]; then
  case "$metadata_uri" in
    http://169.254.170.2/v4/*) ;;
    *)
      echo "ECS_CONTAINER_METADATA_URI_V4 is required for Temporal task identity" >&2
      exit 64
      ;;
  esac
  broadcast_address="$(
    curl --fail --silent --show-error --max-time 3 --retry 2 "${metadata_uri}/task" |
      jq -er '[.Containers[].Networks[]?.IPv4Addresses[]?] | unique | if length == 1 then .[0] else error("expected one task IPv4 address") end'
  )"
fi

if ! printf '%s\n' "$broadcast_address" | awk -F. '
  NF != 4 { exit 1 }
  {
    for (octet = 1; octet <= 4; octet++) {
      if ($octet !~ /^[0-9]+$/ || $octet < 0 || $octet > 255) exit 1
    }
    if ($1 == 0 || $1 == 127 || ($1 == 169 && $2 == 254)) exit 1
  }
'; then
  echo "Temporal task broadcast address must be one routable IPv4 address" >&2
  exit 64
fi

export BIND_ON_IP=0.0.0.0
export TEMPORAL_BROADCAST_ADDRESS="$broadcast_address"
exec temporal-server start "$@"
