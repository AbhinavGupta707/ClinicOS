aws_account_id          = "000000000000"
terraform_state_bucket  = "replace-with-existing-state-bucket"
terraform_lock_table    = "replace-with-existing-lock-table"
offline_validation_mode = true

github_repository         = "OWNER/REPOSITORY"
github_subject_claims     = ["repo:OWNER/REPOSITORY:environment:staging"]
create_github_oidc_provider = false
github_oidc_provider_arn  = "arn:aws:iam::000000000000:oidc-provider/token.actions.githubusercontent.com"

# No domain, certificate, public ingress, runtime, or paging target is assumed.
enable_public_ingress = false
enable_runtime        = false
image_uris            = {}

additional_alarm_action_arns = []
enable_backup_vault_lock     = false
