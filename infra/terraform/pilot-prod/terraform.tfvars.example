environment = "pilot-prod"

aws_account_id         = "123456789012"
primary_region         = "ap-south-1"
dr_region              = "ap-south-2"
terraform_state_bucket = "clinic-os-terraform-state-example"
terraform_lock_table   = "clinic-os-terraform-locks-example"
kms_key_alias          = "alias/clinic-os-pilot-prod"

allow_resource_creation = false

database_publicly_accessible    = false
database_storage_encrypted      = true
database_multi_az_enabled       = true
database_pitr_enabled           = true
database_backup_retention_days = 14

object_storage_encrypted                = true
object_storage_block_public_access      = true
cross_region_backup_replication_enabled = true

secrets_manager_enabled       = true
waf_enabled                   = true
centralized_logs_enabled      = true
cloudwatch_log_retention_days = 90

provider_health_alerts_enabled = true
backup_failure_alerts_enabled  = true

rpo_minutes = 60
rto_minutes = 240
