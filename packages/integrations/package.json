{
  "name": "@clinic-os/integrations",
  "version": "0.0.0",
  "private": true,
  "description": "Provider interfaces, adapters, simulators, and contract fixtures.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1084.0",
    "@aws-sdk/client-lambda": "3.1084.0",
    "@aws-sdk/client-s3": "3.1084.0",
    "@aws-sdk/s3-request-presigner": "3.1084.0",
    "file-type": "22.0.1"
  }
}
