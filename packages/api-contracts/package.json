{
  "name": "@clinic-os/api-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "OpenAPI schemas and generated/shared API contract types.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "find src test -name '*.ts' -exec node --check {} \\;",
    "test": "node --test test/*.test.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "generate": "node ../../scripts/cp12-openapi-generate.mjs",
    "check:generated": "node ../../scripts/cp12-openapi-check.mjs",
    "check:inventory": "node ../../scripts/cp12-openapi-route-inventory.mjs"
  }
}
